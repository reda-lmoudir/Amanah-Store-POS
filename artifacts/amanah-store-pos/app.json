{
  "expo": {
    "name": "Amanah Store POS",
    "slug": "amanah-store-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amanah-store-pos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.amanahstore.pos",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/amanah-icon.png",
        "backgroundColor": "#10251B"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
